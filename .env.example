# Copiar este archivo como .env y ajustar los valores.

# --------------------------------------------------------------- base de datos
# Local, con el Postgres de docker-compose (puerto 5433 en el host):
DATABASE_URL="postgresql://alikai:alikai_local@localhost:5433/alikai?schema=public"
#
# Producción — Supabase (Project Settings > Database):
# 1) DATABASE_URL: Connection string del pooler en modo Transaction (puerto 6543).
#    Añade ?pgbouncer=true al final.
# 2) DIRECT_URL: pooler en modo Session (puerto 5432) o la conexión directa.
#    Las migraciones de Prisma usan DIRECT_URL.
#
# DATABASE_URL="postgresql://postgres.XXXX:CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.XXXX:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------- servidor
PORT=4000
NODE_ENV=development

# Orígenes permitidos por CORS, separados por coma.
# En Railway incluye la URL del frontend (Vercel u otro).
CORS_ORIGENES="http://localhost:3000"

# --------------------------------------------------------------------- sesión
# Generar una clave aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="reemplazar-por-una-clave-aleatoria-de-al-menos-32-caracteres"
JWT_EXPIRACION="8h"

# ---------------------------------------------------- administrador inicial
# Usuario que crea el script de semillas. Cámbialo antes de sembrar en Supabase.
ADMIN_EMAIL="admin@alikaiperu.org"
ADMIN_PASSWORD="definir-una-contrasena-segura"
ADMIN_NOMBRE="Administrador Alikai"
